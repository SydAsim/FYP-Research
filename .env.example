# Local development only. Change POSTGRES_PASSWORD for any shared environment.
POSTGRES_PASSWORD=voice_agent_local
POSTGRES_HOST_PORT=5432
SIMULATOR_POSTGRES_PASSWORD=simulator_local
LOG_LEVEL=INFO
APP_ENV=development
EXPERIMENT_MODE=true
# PostgreSQL is authoritative. Redis is optional and disposable.
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
# Provider-neutral cascaded path is the strict research arm (later phase).
VOICE_PROFILE=cascade
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INTENT_MODEL_ID=
STT_MODEL_ID=
TTS_MODEL_ID=
NATIVE_AUDIO_MODEL_ID=
SESSION_SIGNING_KEY=
