# Environment
APP_ENV=development
EXPERIMENT_MODE=true
LOG_LEVEL=INFO

# PostgreSQL is authoritative
DATABASE_URL=postgresql+asyncpg://voice_agent:change-me@postgres:5432/voice_agent
DATABASE_ADMIN_URL=postgresql://voice_agent:change-me@postgres:5432/voice_agent

# Redis is optional and disposable
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false

# LiveKit
LIVEKIT_URL=wss://replace-me
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Model profiles: pin exact verified identifiers before an experiment freeze
VOICE_PROFILE=cascade
INTENT_MODEL_ID=replace-with-pinned-structured-output-model
NATIVE_AUDIO_MODEL_ID=replace-with-pinned-live-model
STT_MODEL_ID=replace-with-pinned-stt-model
TTS_MODEL_ID=replace-with-pinned-tts-model
MODEL_REGION=replace-me

# Protocol versions
SPEECH_POLICY_VERSION=1.0.0
EVENT_SCHEMA_VERSION=1
PROVIDER_SIMULATOR_VERSION=1.0.0
ORACLE_VERSION=1.0.0

# Bounded recovery
PROVIDER_CONNECT_TIMEOUT_MS=2000
PROVIDER_RESPONSE_TIMEOUT_MS=5000
VERIFICATION_TIMEOUT_MS=3000
RECONCILIATION_MAX_ATTEMPTS=8
REPAIR_DEADLINE_SECONDS=120

# Never expose this signing key to the browser
SESSION_SIGNING_KEY=replace-with-long-random-secret

